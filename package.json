{
  "name": "arsh-enterprises-billing",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "next dev",
    "dev:backend": ".\\backend\\venv\\Scripts\\python.exe -m uvicorn backend.main:app --reload --port 8000 --app-dir .",
    "build": "next build",
    "start": "next start",
    "start:backend": ".\\backend\\venv\\Scripts\\python.exe -m uvicorn backend.main:app --port 8000 --app-dir .",
    "start:all": "concurrently \"npm start\" \"npm run start:backend\"",
    "lint": "next lint",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
