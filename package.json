    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "next": "16.3.5",
    "next-auth": "4.24.15",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.1.2",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "concurrently": "^10.0.5",
    "prisma": "^5.10.2",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
